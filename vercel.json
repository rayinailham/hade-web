{
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/products", "destination": "/index.html" },
    { "source": "/products/clamp-adapter-dslr-2026", "destination": "/index.html" },
    { "source": "/products/clamp-adapter-mirrorless-2026", "destination": "/index.html" },
    { "source": "/products/direc-sensor-dslr-ffd", "destination": "/index.html" },
    { "source": "/products/direc-sensor-sony-emount", "destination": "/index.html" },
    { "source": "/products/direc-sensor-mft", "destination": "/index.html" },
    { "source": "/products/bracket-rigging-system-2026", "destination": "/index.html" },
    { "source": "/products/phone-grip-bluetooth-shooter", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/sitemap.xml",
      "headers": [
        { "key": "Content-Type", "value": "application/xml; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=3600, must-revalidate" }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=3600, must-revalidate" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
